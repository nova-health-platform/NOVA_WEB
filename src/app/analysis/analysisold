<section class="min-h-screen flex justify-center items-center">
  <div class="mx-auto w-full max-w-6xl">
    <div>
      <div *ngIf="errorMessage" class="bg-red-100 text-red-700 p-3 rounded mb-4 text-center max-w-2xl mx-auto">
        {{ errorMessage }}
      </div>

      <div *ngIf="loading" class="text-center text-white mb-4 font-semibold">
        Loading...
      </div>

      <!-- Step 1: Symptoms -->
      <div *ngIf="step === 1" class="max-w-2xl mx-auto p-6 -mt-35">
        <!-- Titre -->
        <h1 class="text-4xl text-center font-extrabold mb-6 text-[#101010] dark:text-white">
          Enter your symptoms
        </h1>

        <!-- Input + Submit -->
        <div class="bg-white/30 dark:bg-white/5 rounded-xl shadow-xl p-2 mb-6 backdrop-blur-md">
          <div class="flex items-center gap-2">
            <!-- Input -->
            <div class="w-full bg-[#f9f9f9] dark:bg-[#101010] rounded-lg">
              <input type="text" [(ngModel)]="searchQuery" (input)="filterSymptoms()" (keydown.enter)="addSymptom()"
                placeholder="Enter a symptom..."
                class="w-full p-3 border-2 border-green-500/80 bg-transparent text-[#101010] dark:text-white rounded-lg focus:outline-none focus:ring-0 focus:border-green-500" />
            </div>

            <!-- Bouton Submit -->
            <div class="bg-[#f9f9f9] dark:bg-[#101010] rounded-lg">
              <button (click)="submitSymptoms()"
                class="cursor-pointer px-4 py-3 rounded-lg bg-green-500/10 border-2 border-green-500/80 text-[#101010] dark:text-white hover:bg-green-500 hover:text-white transition">
                Submit
              </button>
            </div>
          </div>

          <!-- Liste suggestions -->
          <ul *ngIf="filteredSymptoms.length > 0"
            class="w-full bg-white dark:bg-[#1a1a1a] border border-gray-300 dark:border-white/10 rounded-md shadow-lg mt-4 z-10 max-h-40 overflow-y-auto">
            <li *ngFor="let symptom of filteredSymptoms" (click)="addSymptom(symptom)"
              class="p-2 cursor-pointer hover:bg-green-100 dark:hover:bg-green-900/40 text-[#101010] dark:text-white">
              {{ formatSymptom(symptom) }}
            </li>
          </ul>
        </div>

        <!-- Liste des symptômes sélectionnés -->
        <div *ngIf="selectedSymptoms.length > 0" class="mt-4 flex flex-wrap gap-2 justify-center items-center">
          <span *ngFor="let symptom of selectedSymptoms; let i = index"
            class="bg-green-500/10 border-2 border-green-500 text-[#101010] dark:text-white px-3 py-1 rounded-full flex items-center">
            {{ formatSymptom(symptom) }}
            <button (click)="removeSymptom(i)" class="cursor-pointer text-green-500 ml-2 font-bold">
              ✖
            </button>
          </span>
        </div>
      </div>


      <!-- Step 2: Patient Info -->
      <div *ngIf="step === 2" class="max-w-2xl mx-auto p-6 -mt-35">
        <h2 class="text-4xl text-center text-white font-extrabold mb-6">Patient Information</h2>
        <div class="bg-white/3 rounded-xl shadow-xl p-2 mb-2">
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-[#101010] rounded-lg">
              <input type="number" [(ngModel)]="age" placeholder="Age"
                class="w-full p-2 py-3 border-2 border-pink-500 bg-pink-500/10 text-white rounded-lg focus:outline-none focus:ring-0 focus:ring-pink-500" />
            </div>
            <div class="bg-[#101010] rounded-lg">
              <select [(ngModel)]="sex"
                class="w-full p-2 py-3 border-2 border-pink-500 bg-pink-500/10 text-white rounded-lg focus:outline-none focus:ring-0 focus:ring-pink-500">
                <option value="" disabled hidden>Gender</option>
                <option value="male" class="bg-white p-2 cursor-pointer hover:bg-pink-100 text-black">Male</option>
                <option value="female" class="bg-white p-2 cursor-pointer hover:bg-pink-100 text-black">Female</option>
              </select>

            </div>
            <div class="bg-[#101010] rounded-lg">
              <input type="number" [(ngModel)]="weight" placeholder="Weight (kg)"
                class="w-full p-2 py-3 border-2 border-pink-500 bg-pink-500/10 text-white rounded-lg focus:outline-none focus:ring-0 focus:ring-pink-500" />
            </div>
            <div class="bg-[#101010] rounded-lg">
              <input type="number" [(ngModel)]="height" placeholder="Height (cm)"
                class="w-full p-2 py-3 border-2 border-pink-500 bg-pink-500/10 text-white rounded-lg focus:outline-none focus:ring-0 focus:ring-pink-500" />
            </div>
          </div>


        </div>
        <div class="flex justify-between">
          <div class="bg-white/3 p-2 rounded-lg">
            <button (click)="previousStep()"
              class="w-25 cursor-pointer px-4 py-2 rounded-lg bg-pink-500/10 border-2 border-pink-500 text-white hover:bg-pink-500 hover:text-white hover:ring-2 hover:ring-pink-500">
              Back
            </button>
          </div>
          <div class="bg-white/3 p-2 rounded-lg">
            <button (click)="submitPatientInfo()"
              class="w-25 cursor-pointer px-4 py-2 rounded-lg bg-pink-500/10 border-2 border-pink-500 text-white hover:bg-pink-500 hover:text-white hover:ring-2 hover:ring-pink-500">
              Continue
            </button>
          </div>
        </div>

      </div>

      <!-- Step 3: Pain Question -->
      <div *ngIf="step === 3 && painAnswer === null"
        class="w-min mx-auto p-6 text-center bg-white/1 rounded-xl shadow-xl -mt-35">
        <h3 class="text-xl font-semibold mb-6 text-white whitespace-nowrap px-6">Are you experiencing physical pain?
        </h3>
        <div class="flex justify-center gap-6 mb-4">
          <button (click)="answerPainQuestion(true)"
            class="cursor-pointer px-4 py-2 w-30 rounded-lg bg-green-500/10 border-2 border-green-500 text-white hover:bg-green-500 hover:text-white hover:ring-2 hover:ring-green-500">Yes</button>
          <button (click)="answerPainQuestion(false)"
            class="cursor-pointer px-4 py-2 w-30 rounded-lg bg-red-500/10 border-2 border-red-500 text-white hover:bg-red-500 hover:text-white hover:ring-2 hover:ring-red-500">No</button>
        </div>
      </div>

      <div *ngIf="showBodySelection" class="p-6 rounded-lg shadow-md max-w-6xl mx-auto text-center -mt-35">
        <h2 class="text-4xl text-center text-white font-extrabold mb-6">Select your physical pain</h2>
        <div class="bg-white/3 p-4 rounded-xl shadow-xl flex flex-col md:flex-row gap-4 items-stretch justify-center">
          <!-- Instructions + Slider -->
          <div class="w-full md:w-1/2 h-full min-h-[450px] flex flex-col space-y-5">
            <!-- Bloc Instructions -->
            <div
              class="bg-pink-500/10 border-2 border-pink-500 rounded-lg shadow-lg p-6 text-left text-white space-y-4">
              <!-- Titre -->
              <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-pink-400" fill="none" stroke="currentColor" stroke-width="2"
                  viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M12 8c.667-2 2.5-3.5 5-3.5S21 6 21 8c0 2-1.5 3.5-3.5 3.5S14 10 12 8zM4 16l4-4 4 4M4 20h16" />
                </svg>
                <h3 class="text-lg font-bold">Instruction</h3>
              </div>

              <div class="text-sm leading-relaxed">
                <p>To help us understand your discomfort, please indicate the areas where you feel pain using the body
                  silhouette.</p>

                <ul class="list-disc list-inside mt-3 space-y-1">
                  <li>Use the <strong>slider</strong> to choose the size of the selection circle.</li>
                  <li><strong>Click</strong> on the body to place a circle — areas underneath will be selected.</li>
                  <li><strong>Click again</strong> near an existing circle to remove it.</li>
                  <li>You can select <strong>multiple zones</strong> if needed.</li>
                  <li>Make sure you differentiate between the <strong>"Front"</strong> and the <strong>"Back"</strong>
                    to improve diagnostic accuracy.</li>
                </ul>

                <p class="text-sm text-pink-200 mt-2">
                  Selected areas will appear as semi-transparent pink circles.
                </p>

                <p class="text-sm text-pink-200 mt-2 italic">
                  Example: For shoulder pain, click near the top arm/shoulder section.
                </p>
              </div>


            </div>

            <div class="flex-grow bg-[#3b6fff]/10 border-2 border-[#3b6fff] p-6 rounded-lg text-sm text-white relative">
              <div class="flex items-center gap-3">
                <h3 class="text-lg font-bold mb-5">Circle Size</h3>
              </div>

              <!-- Slider input -->
              <div class="px-0">
                <input id="circleSizeSlider" type="range" min="1" max="3" step="1" [(ngModel)]="circleSizeIndex" class="w-full h-4 bg-[#3b6fff]/30 rounded-lg appearance-none cursor-pointer transition-all
            focus:outline-none focus:ring-1 focus:ring-[#3b6fff]
            [&::-webkit-slider-thumb]:appearance-none
            [&::-webkit-slider-thumb]:h-4
            [&::-webkit-slider-thumb]:w-4
            [&::-webkit-slider-thumb]:rounded-full
            [&::-webkit-slider-thumb]:bg-white
            [&::-webkit-slider-thumb]:border-2
            [&::-webkit-slider-thumb]:border-blue-500
            [&::-webkit-slider-thumb]:transition
            [&::-webkit-slider-thumb]:hover:scale-110
            [&::-moz-range-thumb]:bg-blue-500/0
            [&::-moz-range-thumb]:border-2
            [&::-moz-range-thumb]:border-pink-500
            [&::-moz-range-thumb]:rounded-full
            [&::-moz-range-thumb]:h-4
            [&::-moz-range-thumb]:w-4" />

                <!-- Labels bien alignés -->
                <div class="relative mt-4 h-4 w-full">
                  <span class="absolute left-0 transform -translate-x-0/2 text-xs">Small</span>
                  <span class="absolute left-1/2 transform -translate-x-1/2 text-xs">Medium</span>
                  <span class="absolute left-full transform -translate-x-2/2 text-xs">Large</span>
                </div>
              </div>
            </div>



          </div>

          <!-- Silhouettes -->
          <div
            class="w-full md:w-1/2 flex justify-center gap-8 bg-[#3b6fff]/10 pt-15 rounded-lg shadow-lg border-2 border-[#3b6fff]">
            <!-- Front -->
            <div class="flex flex-col items-center">
              <svg (click)="handleSvgClick($event, 'front')" (mousemove)="handleSvgHover($event, 'front')"
                (mouseleave)="hoverCircleFront = null" class="w-[150px] md:w-[200px] h-auto" viewBox="59 0 100 190"
                preserveAspectRatio="xMidYMid meet">
                <g id="effects-layer-front"></g>

                <!-- Corps -->
                <ng-container *ngFor="let path of svgFrontPaths">
                  <ng-container *ngIf="path.id === 'body'">
                    <path [attr.d]="path.d" [attr.id]="path.id" fill="#3b6fff" [style.pointer-events]="'none'"></path>
                  </ng-container>
                </ng-container>

                <!-- Zones interactives -->
                <ng-container *ngFor="let path of svgFrontPaths">
                  <ng-container *ngIf="path.id !== 'body'">
                    <path [attr.d]="path.d" [attr.id]="path.id" fill="transparent" [style.pointer-events]="'auto'">
                    </path>
                  </ng-container>
                </ng-container>

                <!-- Cercles de sélection -->
                <circle *ngFor="let circle of selectionCirclesFront" [attr.cx]="circle.cx" [attr.cy]="circle.cy"
                  [attr.r]="circle.r" fill="rgba(255,255,255,0.1)" stroke="#ec4899" stroke-width="1" />

                <!-- Cercle de hover -->
                <circle *ngIf="hoverCircleFront" [attr.cx]="hoverCircleFront.cx" [attr.cy]="hoverCircleFront.cy"
                  [attr.r]="hoverCircleFront.r" fill="rgba(255,255,255,0.2)" stroke="#ffffff" stroke-dasharray="2"
                  stroke-width="1" />
              </svg>
              <div class="mt-2 text-white text-sm font-semibold">Front</div>
            </div>

            <!-- Back -->
            <div class="flex flex-col items-center">
              <svg (click)="handleSvgClick($event, 'back')" (mousemove)="handleSvgHover($event, 'back')"
                (mouseleave)="hoverCircleBack = null" class="w-[150px] md:w-[200px] h-auto" viewBox="59 0 100 190"
                preserveAspectRatio="xMidYMid meet">
                <g id="effects-layer-back"></g>

                <ng-container *ngFor="let path of svgBackPaths">
                  <ng-container *ngIf="path.id === 'body'">
                    <path [attr.d]="path.d" [attr.id]="path.id" fill="#3b6fff" [style.pointer-events]="'none'"></path>
                  </ng-container>
                </ng-container>

                <ng-container *ngFor="let path of svgBackPaths">
                  <ng-container *ngIf="path.id !== 'body'">
                    <path [attr.d]="path.d" [attr.id]="path.id" fill="transparent" [style.pointer-events]="'auto'">
                    </path>
                  </ng-container>
                </ng-container>

                <circle *ngFor="let circle of selectionCirclesBack" [attr.cx]="circle.cx" [attr.cy]="circle.cy"
                  [attr.r]="circle.r" fill="rgba(255,255,255,0.1)" stroke="#ec4899" stroke-width="1" />

                <circle *ngIf="hoverCircleBack" [attr.cx]="hoverCircleBack.cx" [attr.cy]="hoverCircleBack.cy"
                  [attr.r]="hoverCircleBack.r" fill="rgba(255,255,255,0.2)" stroke="#ffffff" stroke-dasharray="2"
                  stroke-width="1" />
              </svg>
              <div class="mt-2 text-white text-sm font-semibold">Back</div>
            </div>
          </div>
        </div>

        <!-- Boutons -->
        <div class="flex justify-end">
          <div class="mt-4 bg-white/3 p-2 rounded-xl flex gap-2">
            <button (click)="resetBodySelection()"
              class="cursor-pointer rounded-md px-5 py-2.5 text-sm font-medium bg-pink-500/10 border-2 border-pink-500 text-white hover:bg-pink-500 hover:text-white">
              Reset
            </button>
            <button (click)="validateBodySelection()"
              class="cursor-pointer rounded-md px-5 py-2.5 text-sm font-medium bg-[#3b6fff]/10 border-2 border-[#3b6fff] text-white hover:bg-[#3b6fff] hover:text-white">
              Confirm selection
            </button>
          </div>

        </div>
      </div>

      <div *ngIf="currentClarification" class="w-min mx-auto p-6 text-center bg-white/1 rounded-xl -mt-35">
        <div class="text-xl font-semibold mb-6 text-white whitespace-nowrap px-6">
          {{ currentClarification.question }}
        </div>
        <div class="flex justify-center gap-6">
          <button (click)="answerClarification(true)"
            class="cursor-pointer px-4 py-2 w-30 rounded-lg bg-green-500/10 border-2 border-green-500 text-white hover:bg-green-500 hover:text-white hover:ring-2 hover:ring-green-500">Yes</button>
          <button (click)="answerClarification(false)"
            class="cursor-pointer px-4 py-2 w-30 rounded-lg bg-red-500/10 border-2 border-red-500 text-white hover:bg-red-500 hover:text-white hover:ring-2 hover:ring-red-500">No</button>
        </div>
      </div>

      <div *ngIf="response && !currentClarification && response.predicted_disease" class="text-center mt-10">
        <h2 class="text-4xl font-extrabold text-white">Analysis Result</h2>
        <p class="text-sm mx-auto text-white/80 mt-3 mb-8 max-w-4xl">
          This section presents the outcome of the symptom analysis, including the most likely diagnosis, its severity,
          and related clinical information. It is derived from your input and enhanced by contextual medical data to
          offer an accurate, data-driven health insight.
        </p>
        <div>
          <div class="bg-white/3 p-3 rounded-xl max-w-6xl mx-auto text-white">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left">
              <!-- LEFT COLUMN -->
              <div class="flex flex-col h-full gap-4">
                <!-- Top: Diagnostic Info -->
                <div class="p-4 rounded-xl shadow-md bg-pink-500/10 border border-pink-500/80">
                  <!-- Confidence bar -->
                  <div class="relative">
                    <div class="absolute top-0 right-0 w-60 rounded-xl shadow-lg bg-pink-500/5">
                      <div class="h-full w-full pt-1.5 pb-2 px-2 rounded-xl">
                        <div class="flex items-center justify-between mb-1">
                          <span class="text-[10px] font-semibold text-white uppercase">Confidence</span>
                          <span class="text-xs font-bold" [style.color]="getGradientColor(animatedConfidence)">
                            {{ animatedConfidence }}%
                          </span>
                        </div>
                        <div class="w-full h-2 bg-pink-500/10 rounded-full overflow-hidden">
                          <div class="h-full rounded-full transition-all duration-100" [ngStyle]="{
              width: animatedConfidence + '%',
              backgroundColor: getGradientColor(animatedConfidence)
            }"></div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <h3 class="text-2xl font-bold mb-4 text-white text-left">Diagnostic Result</h3>

                  <!-- Disease description -->
                  <div class="text-sm p-4 rounded-xl shadow bg-pink-500/10 text-justify space-y-1">
                    <p class="text-lg">
                      <span class="font-semibold text-pink-400">{{ formatDiseaseLabel(response.predicted_disease)
                        }}</span>
                    </p>
                    <div class="overflow-hidden transition-[max-height] duration-500 ease-in-out"
                      [style.maxHeight]="isDescriptionExpanded ? '1000px' : '3.5rem'"
                      [style.opacity]="isDescriptionExpanded ? '1' : '1'">
                      {{ response.disease_info.description }}
                    </div>
                    <button *ngIf="response.disease_info.description?.length > textLimit"
                      (click)="isDescriptionExpanded = !isDescriptionExpanded"
                      class="cursor-pointer text-pink-400 hover:underline text-xs font-medium mt-1">
                      {{ isDescriptionExpanded ? 'Read less' : 'Read more' }}
                    </button>
                  </div>
                </div>

                <!-- Bottom: Gauges take all remaining space -->
                <div
                  class="flex-1 p-4 rounded-xl shadow-md bg-pink-500/10 flex flex-col justify-center border border-pink-500/80">
                  <h3 class="text-2xl font-bold mb-4 text-white text-left">Clinical Indicators</h3>
                  <div class="flex justify-center items-center gap-16 flex-wrap p-4 rounded-xl bg-pink-500/10 h-full">
                    <!-- Severity -->
                    <div
                      class="relative w-28 h-28 cursor-pointer rounded-full ring-1 ring-white/10 shadow-md backdrop-blur-md transition-transform duration-100 hover:scale-105 hover:bg-white/5">
                      <svg class="size-full -rotate-225" viewBox="0 0 36 36">
                        <circle cx="18" cy="18" r="16" fill="none" stroke-width="2" stroke="#334155"
                          stroke-dasharray="75 100" stroke-linecap="round" />
                        <circle cx="18" cy="18" r="16" fill="none" stroke-width="2"
                          [attr.stroke]="getSeverityColor(animatedSeverity)"
                          [attr.stroke-dasharray]="(animatedSeverity * 0.75 / 100 * 100).toFixed(2) + ' 100'"
                          stroke-linecap="round" />
                      </svg>
                      <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                        <span class="text-base font-semibold leading-tight"
                          [style.color]="getSeverityColor(animatedSeverity)">
                          {{ response.disease_info.severity_level.replace('.', '') }}
                        </span>
                        <span class="text-xs text-white/70">Severity</span>
                      </div>
                    </div>

                    <!-- Contagious -->
                    <div
                      class="relative w-28 h-28 cursor-pointer rounded-full ring-1 ring-white/10 shadow-md backdrop-blur-md transition-transform duration-100 hover:scale-105 hover:bg-white/5">
                      <svg class="size-full -rotate-225" viewBox="0 0 36 36">
                        <circle cx="18" cy="18" r="16" fill="none" stroke-width="2" stroke="#334155"
                          stroke-dasharray="75 100" stroke-linecap="round" />
                        <circle cx="18" cy="18" r="16" fill="none" stroke-width="2"
                          [attr.stroke]="getContagiousColor(response.disease_info.contagious)"
                          [attr.stroke-dasharray]="(animatedContagious * 0.75).toFixed(2) + ' 100'"
                          stroke-linecap="round" />
                      </svg>
                      <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                        <span class="text-base font-semibold leading-tight"
                          [style.color]="getContagiousColor(response.disease_info.contagious)">
                          {{ response.disease_info.contagious.replace('.', '') }}
                        </span>
                        <span class="text-xs text-white/70">Contagious</span>
                      </div>
                    </div>

                    <!-- Chronic/Acute -->
                    <div
                      class="relative w-28 h-28 cursor-pointer rounded-full ring-1 ring-white/10 shadow-md backdrop-blur-md transition-transform duration-100 hover:scale-105 hover:bg-white/5">
                      <svg class="size-full -rotate-225" viewBox="0 0 36 36">
                        <circle cx="18" cy="18" r="16" fill="none" stroke-width="2" stroke="#334155"
                          stroke-dasharray="75 100" stroke-linecap="round" />
                        <circle cx="18" cy="18" r="16" fill="none" stroke-width="2"
                          [attr.stroke]="getCourseColor(response.disease_info.chronic_or_acute)"
                          [attr.stroke-dasharray]="(animatedCourse * 0.75).toFixed(2) + ' 100'"
                          stroke-linecap="round" />
                      </svg>
                      <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                        <span class="text-sm font-semibold"
                          [style.color]="getCourseColor(response.disease_info.chronic_or_acute)">
                          {{ response.disease_info.chronic_or_acute.replace('.', '') }}
                        </span>
                        <span class="text-xs text-white/70">Course</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>


              <!-- RIGHT COLUMN -->
              <div class="flex flex-col gap-4">
                <div *ngIf="response.disease_info"
                  class="relative p-4 rounded-xl shadow-md h-full bg-pink-500/10 border border-pink-500/80">
                  <h3 class="text-2xl font-bold mb-4 text-white">Recommended Actions</h3>
                  <div class="overflow-x-auto rounded-xl shadow bg-pink-500/10">
                    <table class="min-w-full text-sm text-left text-white table-auto rounded-xl">
                      <tbody class="divide-y divide-pink-500/20">
                        <tr>
                          <th class="ps-5 py-3 text-pink-400 font-semibold whitespace-nowrap">🩷</th>
                          <td class="ps-5 pe-5 py-3">{{ response.disease_info.advice }}</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>

                </div>
                <div *ngIf="response.disease_info"
                  class="relative p-4 rounded-xl shadow-md h-full bg-pink-500/10 border border-pink-500/80">
                  <h3 class="text-2xl font-bold mb-4 text-white">Disease Informations</h3>

                  <div class="overflow-x-auto rounded-xl shadow bg-pink-500/10">
                    <table class="min-w-full text-sm text-left text-white table-auto rounded-xl">
                      <tbody class="divide-y divide-pink-500/20">
                        <tr>
                          <th class="px-4 py-3 text-pink-400 font-semibold whitespace-nowrap">Risk Factors</th>
                          <td class="px-4 py-3">{{ response.disease_info.risk_factor }}</td>
                        </tr>
                        <tr>
                          <th class="px-4 py-3 text-pink-400 font-semibold whitespace-nowrap">Prevention</th>
                          <td class="px-4 py-3">{{ response.disease_info.prevention }}</td>
                        </tr>
                        <tr>
                          <th class="px-4 py-3 text-pink-400 font-semibold whitespace-nowrap">Complications</th>
                          <td class="px-4 py-3">{{ response.disease_info.complications }}</td>
                        </tr>
                        <tr>
                          <th class="px-4 py-3 text-pink-400 font-semibold whitespace-nowrap">Related Diseases</th>
                          <td class="px-4 py-3">{{ response.disease_info.related_diseases }}</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>

                </div>
              </div>
            </div>
          </div>
        </div>
        <div>

          <div *ngIf="showDemographicsSection">
            <h2 class="text-4xl font-extrabold mt-20 text-white">Disease Demographics Overview</h2>
            <p class="text-sm mx-auto text-white/70 mt-3 max-w-4xl">
              This section illustrates the typical demographic distribution of the predicted disease, highlighting which
